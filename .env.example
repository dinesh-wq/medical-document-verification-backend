# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ---------------------------------------------------
# REQUIRED: PostgreSQL connection string
# For Supabase: get from Project Settings > Database > Connection string (Transaction mode)
# ---------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ---------------------------------------------------
# REQUIRED: Secret for signing JWT tokens
# Use any long random string (min 32 chars) - keep this consistent across restarts
# ---------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret-string-here

# ---------------------------------------------------
# REQUIRED: Gemini API key for AI features
# Get from: https://aistudio.google.com/app/apikey
# ---------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# ---------------------------------------------------
# OPTIONAL: Which Gemini model to use (defaults shown)
# ---------------------------------------------------
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------
# OPTIONAL: Server port (Render sets PORT automatically)
# ---------------------------------------------------
PORT=4000

# ---------------------------------------------------
# OPTIONAL: Comma-separated list of allowed frontend origins
# Add your Vercel URL here for production
# All *.vercel.app domains are already allowed by code
# ---------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000,https://your-app.vercel.app
